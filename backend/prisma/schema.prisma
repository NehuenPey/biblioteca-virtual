generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  ADMIN
}

enum BookCopyStatus {
  AVAILABLE
  LOANED
  MAINTENANCE
  RETIRED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  RETURNED
  OVERDUE
}

model User {
  id           String     @id @default(cuid())
  nombre       String
  apellido     String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(READER)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  loans        Loan[]
  favorites    Favorite[]
}

model Book {
  id        String   @id @default(cuid())
  titulo    String
  autor     String
  editorial String?
  isbn      String?  @unique
  genero    String
  anio      Int?
  sinopsis  String?
  portada   String?
  destacado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copies    BookCopy[]
  favorites Favorite[]
}

model BookCopy {
  id              String          @id @default(cuid())
  bookId          String
  codigoInventario String         @unique
  estado          BookCopyStatus  @default(AVAILABLE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  book            Book            @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loans           Loan[]

  @@index([bookId])
  @@index([estado])
}

model Loan {
  id                 String     @id @default(cuid())
  userId             String
  bookCopyId         String
  fechaSolicitud     DateTime   @default(now())
  fechaPrestamo      DateTime?
  fechaVencimiento   DateTime?
  fechaDevolucion    DateTime?
  estado             LoanStatus @default(PENDING)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookCopy           BookCopy   @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)

  @@index([userId, estado])
  @@index([bookCopyId, estado])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}
